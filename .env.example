# Server-only: never prefix secrets with VITE_
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Inbox receiving website inquiries. The sender above must use a Resend-verified domain.
CONTACT_TO_EMAIL=the.musicnook12@gmail.com
# Exact allowed browser origin (e.g. your Netlify production URL)
CONTACT_ALLOWED_ORIGIN=
# Public build configuration
SITE_URL=
# Set true only after replacing placeholders and verifying launch content
SITE_READY=false
SEARCH_CONSOLE_VERIFICATION=

# Optional public, hostname-restricted CARTO basemap key
VITE_CARTO_BASEMAP_KEY=
NODE_ENV=production
